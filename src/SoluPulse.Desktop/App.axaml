<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:SoluPulse.Desktop.Views"
             x:Class="SoluPulse.Desktop.App"
             RequestedThemeVariant="Default">
  <!-- RequestedThemeVariant="Default" : clair ou sombre selon le réglage de Windows (ENF-ERG-04). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackground" Color="#F4F6F9" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E3E8EF" />
          <SolidColorBrush x:Key="TileBackground" Color="#F4F6F9" />
          <SolidColorBrush x:Key="Track" Color="#DFE5EC" />
          <SolidColorBrush x:Key="MutedText" Color="#566373" />
          <SolidColorBrush x:Key="Accent" Color="#0E7490" />
          <SolidColorBrush x:Key="AccentHover" Color="#0B5F76" />
          <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentSoft" Color="#E3F3F6" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#0B2338" />
          <SolidColorBrush x:Key="SidebarText" Color="#C3D2DF" />
          <SolidColorBrush x:Key="SidebarHover" Color="#14334D" />
          <SolidColorBrush x:Key="SidebarSelected" Color="#1B4767" />
          <SolidColorBrush x:Key="BannerBackground" Color="#FDECEA" />
          <SolidColorBrush x:Key="BannerText" Color="#8A1C14" />
          <BoxShadows x:Key="CardShadow">0 1 3 0 #12000000, 0 4 12 0 #0A0B2338</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackground" Color="#11161C" />
          <SolidColorBrush x:Key="CardBackground" Color="#1A2129" />
          <SolidColorBrush x:Key="CardBorder" Color="#2A3440" />
          <SolidColorBrush x:Key="TileBackground" Color="#212A34" />
          <SolidColorBrush x:Key="Track" Color="#34404D" />
          <SolidColorBrush x:Key="MutedText" Color="#A9B5C2" />
          <SolidColorBrush x:Key="Accent" Color="#38BDD8" />
          <SolidColorBrush x:Key="AccentHover" Color="#67D2E6" />
          <SolidColorBrush x:Key="AccentForeground" Color="#05242C" />
          <SolidColorBrush x:Key="AccentSoft" Color="#173540" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#0A1219" />
          <SolidColorBrush x:Key="SidebarText" Color="#B4C3D1" />
          <SolidColorBrush x:Key="SidebarHover" Color="#15212C" />
          <SolidColorBrush x:Key="SidebarSelected" Color="#1C3343" />
          <SolidColorBrush x:Key="BannerBackground" Color="#4A1D1A" />
          <SolidColorBrush x:Key="BannerText" Color="#FFD7D3" />
          <BoxShadows x:Key="CardShadow">0 1 3 0 #33000000</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Cartes et tuiles -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22,20" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.gauge">
      <Setter Property="Background" Value="{DynamicResource TileBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="ItemsControl.live Border.gauge">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="Border.chip v|IconView">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Barres de progression : sans largeur minimale, sinon elles débordent des tuiles étroites. -->
    <Style Selector="ProgressBar:horizontal">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
    </Style>

    <!-- Textes -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource BannerText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Boutons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
    </Style>
    <Style Selector="Button v|IconView">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- Navigation latérale -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon ToolTipText="SoluPulse">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Ouvrir SoluPulse" Click="OnTrayOpen" />
            <NativeMenuItem Header="Lancer un diagnostic complet" Click="OnTrayDiagnostic" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quitter l'application" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
