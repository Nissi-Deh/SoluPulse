<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoluPulse.Desktop.ViewModels"
             x:Class="SoluPulse.Desktop.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Inventaire" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Ce que SoluPulse a relevé sur ce PC. Ces informations restent sur votre PC." />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InventoryEntry">
            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,8">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Date}" Classes="muted" />
                </StackPanel>
              </Expander.Header>
              <SelectableTextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
