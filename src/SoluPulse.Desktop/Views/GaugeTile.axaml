<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoluPulse.Desktop.ViewModels"
             x:Class="SoluPulse.Desktop.Views.GaugeTile"
             x:DataType="vm:GaugeItem">
  <Border Classes="gauge" Width="196" Margin="0,0,12,12">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding Label}" Classes="label" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
      <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ProgressBar Value="{Binding Percent}" Maximum="100" Foreground="{Binding Brush}" IsVisible="{Binding HasBar}" />
      <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" Width="28" HorizontalAlignment="Left" IsVisible="{Binding !HasBar}" />
    </StackPanel>
  </Border>
</UserControl>
