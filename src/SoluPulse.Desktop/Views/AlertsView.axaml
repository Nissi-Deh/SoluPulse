<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoluPulse.Desktop.ViewModels"
             x:Class="SoluPulse.Desktop.Views.AlertsView"
             x:DataType="vm:AlertsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Alertes" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Les problèmes détectés sur votre PC, expliqués simplement, avec les corrections proposées." />
      <CheckBox Content="Afficher aussi les alertes résolues" IsChecked="{Binding ShowResolved}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="muted" Text="Aucune alerte." IsVisible="{Binding IsEmpty}" />
    </StackPanel>

    <Grid ColumnDefinitions="340,*">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AlertItem">
            <StackPanel Spacing="4" Margin="0,6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badge" Background="{Binding SeverityBrush}">
                  <TextBlock Text="{Binding SeverityLabel}" />
                </Border>
                <TextBlock Text="Résolue" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding !Active}" />
              </StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Subject}" Classes="muted" IsVisible="{Binding HasSubject}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="1" Margin="20,0,0,0" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Classes="card" DataContext="{Binding Selected}" x:DataType="vm:AlertItem" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Background="{Binding SeverityBrush}">
                <TextBlock Text="{Binding SeverityLabel}" />
              </Border>
              <TextBlock Text="{Binding OpenedText}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subject}" Classes="muted" IsVisible="{Binding HasSubject}" />
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="15" />
            <StackPanel Spacing="2">
              <TextBlock Text="Cause probable" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Cause}" TextWrapping="Wrap" />
            </StackPanel>
            <Expander Header="Explication technique" IsVisible="{Binding HasTechnical}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Technical}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ValueText}" Classes="muted" />
              </StackPanel>
            </Expander>

            <TextBlock Text="Corrections proposées" FontWeight="SemiBold" Margin="0,8,0,0" IsVisible="{Binding ShowCorrections}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowNoCorrection}"
                       Text="Aucune correction automatique pour ce problème : suivez l'explication ci-dessus." />
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Active}"
                       Text="Le problème a disparu : il n'y a rien à faire. SoluPulse vous préviendra s'il revient." />
            <ItemsControl ItemsSource="{Binding Corrections}" IsVisible="{Binding ShowCorrections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActionItem">
                  <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="primary" Content="Corriger…" VerticalAlignment="Center" Margin="12,0,0,0"
                              Command="{Binding $parent[UserControl].((vm:AlertsViewModel)DataContext).FixCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
