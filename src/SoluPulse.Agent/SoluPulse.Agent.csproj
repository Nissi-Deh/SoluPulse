<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SoluPulse.Agent</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Empreinte mémoire minimale (ENF-PERF-02) : GC poste de travail, non concurrent. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoluPulse.Core\SoluPulse.Core.csproj" />
    <ProjectReference Include="..\SoluPulse.Storage\SoluPulse.Storage.csproj" />
    <ProjectReference Include="..\SoluPulse.Platform.Windows\SoluPulse.Platform.Windows.csproj" />
    <ProjectReference Include="..\SoluPulse.Contracts\SoluPulse.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\rules\**\*.yaml" LinkBase="rules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SoluPulse.Agent.Tests" />
  </ItemGroup>
</Project>
